rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users profile collection
    match /lumira_users/{userId} {
      allow read, write: if true;
    }
    // Messages collection
    match /lumira_messages/{messageId} {
      allow read, write: if true;
    }
    // Conversations collection
    match /lumira_conversations/{conversationId} {
      allow read, write: if true;
    }
    // Default fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
